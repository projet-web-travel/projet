<?php
class User {
    private $conn;
    private $table1 = "inscription";
    private $table2 = "connexion";

    public $id;
    public $nom;
    public $prenom;
    public $email;
    public $telephone;
    public $date_naissance;
    public $mot_de_passe;

    public function __construct($db) {
        $this->conn = $db;
    }

    public function register() {
        try {
            $this->conn->beginTransaction();

            // Insertion dans la table inscription
            $query1 = "INSERT INTO " . $this->table1 . " (nom, prenom, email, telephone, date_naissance)
                       VALUES (:nom, :prenom, :email, :telephone, :date_naissance)";
            $stmt1 = $this->conn->prepare($query1);
            $stmt1->bindParam(":nom", $this->nom);
            $stmt1->bindParam(":prenom", $this->prenom);
            $stmt1->bindParam(":email", $this->email);
            $stmt1->bindParam(":telephone", $this->telephone);
            $stmt1->bindParam(":date_naissance", $this->date_naissance);

            if ($stmt1->execute()) {
                $last_id = $this->conn->lastInsertId();

                // Insertion dans la table connexion
                $query2 = "INSERT INTO " . $this->table2 . " (email, mot_de_passe, id_utilisateur)
                           VALUES (:email, :mot_de_passe, :id_utilisateur)";
                $stmt2 = $this->conn->prepare($query2);

                $hashed_password = password_hash($this->mot_de_passe, PASSWORD_DEFAULT);
                $stmt2->bindParam(":email", $this->email);
                $stmt2->bindParam(":mot_de_passe", $hashed_password);
                $stmt2->bindParam(":id_utilisateur", $last_id);

                if ($stmt2->execute()) {
                    $this->conn->commit();
                    return true;
                }
            }

            $this->conn->rollBack();
            return false;

        } catch (PDOException $e) {
            $this->conn->rollBack();
            error_log("Erreur d'inscription : " . $e->getMessage());
            return false;
        }
    }

    public function login($email, $mot_de_passe) {
        $query = "SELECT * FROM " . $this->table2 . " WHERE email = :email LIMIT 1";
        $stmt = $this->conn->prepare($query);
        $stmt->bindParam(":email", $email);
        $stmt->execute();

        if ($stmt->rowCount() > 0) {
            $row = $stmt->fetch(PDO::FETCH_ASSOC);
            if (password_verify($mot_de_passe, $row['mot_de_passe'])) {
                return [
                    'id_utilisateur' => $row['id_utilisateur'],
                    'email' => $row['email']
                ];
            }
        }

        return false;
    }
}
?>
